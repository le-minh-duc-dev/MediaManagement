{
  "AllowedHosts": "*",
  "Authentication": {
    "Authority": "",
    "Audience": ""
  },
  "Uploads": {
    "BucketName": "",
    "Region": "ap-southeast-1",
    "MaxItems": 20,
    "MaxFileSizeBytes": 104857600,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "image/gif", "video/mp4" ],
    "UrlLifetimeMinutes": 15,
    "SessionLifetimeMinutes": 60,
    "CleanupAfterHours": 23,
    "CleanupIntervalMinutes": 5,
    "CleanupBatchSize": 100,
    "CleanupEnabled": true,
    "DownloadUrlLifetimeMinutes": 60
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=MediaManagement.db"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Destructure": [
      {
        "Name": "With",
        "Args": {
          "policy": "MediaManagement.CustomPolicy, MediaManagement"
        }
      },
      {
        "Name": "ToMaximumDepth",
        "Args": {
          "maximumDestructuringDepth": 4
        }
      },
      {
        "Name": "ToMaximumStringLength",
        "Args": {
          "maximumStringLength": 512
        }
      },
      {
        "Name": "ToMaximumCollectionCount",
        "Args": {
          "maximumCollectionCount": 10
        }
      }
    ],
    "Properties": {
      "Application": "MediaManagement"
    }
  }
}
